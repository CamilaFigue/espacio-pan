---
// Portada: lo primero que ve el visitante, con una foto de fondo.
import { getImage } from 'astro:assets';
import { departamento } from '../data/departamento.js';
import { foto } from '../lib/fotos.js';

// getImage genera una versión optimizada de la foto (más liviana que la original)
const fondo = await getImage({ src: foto(departamento.fotoPortada), width: 1920, format: 'webp' });
---

<div class="portada" id="inicio" style={`background-image: url(${fondo.src})`}>
	<div class="contenido">
		<h1>{departamento.nombre}</h1>
		<p class="lema">{departamento.lema}</p>
		<a class="boton" href="#disponibilidad">Ver disponibilidad</a>
	</div>
</div>

<style>
	/* Los estilos dentro de un componente solo afectan a ese componente. */
	.portada {
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 2rem 1rem;
		background-size: cover;
		background-position: center 60%;
		position: relative;
		color: white;
	}
	/* Capa oscura sobre la foto para que el texto se lea bien */
	.portada::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.45));
	}
	.contenido { position: relative; }
	h1 { font-size: clamp(2.8rem, 9vw, 5rem); margin: 0; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35); }
	.lema { font-size: 1.3rem; margin: 0.5rem 0 2rem; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4); }
</style>
