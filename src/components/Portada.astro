---
// Portada: lo primero que ve el visitante.
import { departamento } from '../data/departamento.js';
---

<div class="portada" id="inicio">
	<h1>{departamento.nombre}</h1>
	<p class="lema">{departamento.lema}</p>
	<a class="boton" href="#disponibilidad">Ver disponibilidad</a>
</div>

<style>
	/* Los estilos dentro de un componente solo afectan a ese componente. */
	.portada {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 2rem 1rem;
		background: linear-gradient(160deg, var(--acento-claro), var(--fondo));
	}
	h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); margin: 0; }
	.lema { font-size: 1.25rem; color: var(--suave); margin: 0.5rem 0 2rem; }
</style>
