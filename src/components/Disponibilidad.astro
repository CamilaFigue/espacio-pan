---
// Calendario de disponibilidad con elección de fechas.
// Las fechas ocupadas salen de dos lugares:
//  - src/data/ocupado.json: se llena solo con los calendarios de Airbnb y Booking
//  - src/data/departamento.js: fechas que bloqueás a mano
// El calendario se dibuja en el navegador del visitante (con JavaScript)
// para que "hoy" siempre sea el día real en que alguien mira la página.
import { departamento } from '../data/departamento.js';
import ocupadoSincronizado from '../data/ocupado.json';

const datos = {
	ocupado: [...ocupadoSincronizado, ...departamento.ocupado],
	precio: departamento.precioPorNoche,
	minimoNoches: departamento.minimoNoches,
	nombre: departamento.nombre,
	whatsapp: departamento.contacto.whatsapp,
	email: departamento.contacto.email,
};
const huespedes = Array.from({ length: departamento.maximoHuespedes }, (_, i) => i + 1);
---

<section id="disponibilidad">
	<h2>Disponibilidad y precios</h2>

	<!-- Buscador: muestra las fechas elegidas y el botón para consultar -->
	<div class="buscador">
		<div class="campo">
			<span class="etiqueta">Llegada</span>
			<span id="txt-entrada" class="valor vacio">Elegí una fecha</span>
		</div>
		<div class="campo">
			<span class="etiqueta">Salida</span>
			<span id="txt-salida" class="valor vacio">Elegí una fecha</span>
		</div>
		<label class="campo ultimo">
			<span class="etiqueta">Huéspedes</span>
			<select id="huespedes" class="valor">
				{huespedes.map((n) => <option value={n} selected={n === 2}>{n} {n === 1 ? 'huésped' : 'huéspedes'}</option>)}
			</select>
		</label>
		<a id="consultar" class="boton desactivado" target="_blank" aria-disabled="true">Consultar por WhatsApp</a>
	</div>
	<p id="resumen" class="resumen">Tocá en el calendario el día de llegada y después el de salida.</p>

	<p class="ayuda">
		<span class="muestra libre"></span> libre
		<span class="muestra ocupado"></span> ocupado
		· Precio por noche: <strong>${datos.precio.toLocaleString('es-AR')}</strong>
	</p>

	<div class="controles">
		<button id="limpiar" class="limpiar" hidden>Borrar fechas</button>
		<button id="anterior" class="flecha" aria-label="Meses anteriores">‹</button>
		<button id="siguiente" class="flecha" aria-label="Meses siguientes">›</button>
	</div>
	<div id="calendario" class="meses"></div>
</section>

<!-- define:vars pasa datos de Astro (servidor) al JavaScript del navegador -->
<script define:vars={{ datos }}>
	const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio',
		'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
	const DIAS = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
	const DIAS_LARGOS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
	const UN_DIA = 24 * 60 * 60 * 1000;

	// Convierte "2026-10-10" en una fecha local (sin problemas de zona horaria)
	const aFecha = (txt) => {
		const [a, m, d] = txt.split('-').map(Number);
		return new Date(a, m - 1, d);
	};
	const aTexto = (f) =>
		`${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, '0')}-${String(f.getDate()).padStart(2, '0')}`;
	const pesos = (n) => '$' + n.toLocaleString('es-AR');
	const corta = (f) => `${DIAS_LARGOS[f.getDay()].slice(0, 3)} ${f.getDate()}/${f.getMonth() + 1}`;
	const larga = (f) => `${DIAS_LARGOS[f.getDay()]} ${f.getDate()}/${f.getMonth() + 1}/${f.getFullYear()}`;
	const noches = (desde, hasta) => Math.round((hasta - desde) / UN_DIA);

	// Una noche está ocupada si cae entre "desde" (incluido) y "hasta" (excluido).
	// "hasta" es el día del check-out, que queda libre para el próximo huésped.
	const rangos = datos.ocupado.map((r) => [aFecha(r.desde), aFecha(r.hasta)]);
	const estaOcupado = (fecha) => rangos.some(([desde, hasta]) => fecha >= desde && fecha < hasta);

	const hoy = new Date();
	hoy.setHours(0, 0, 0, 0);
	let desplazamiento = 0; // cuántos meses nos movimos con las flechas
	let entrada = null;
	let salida = null;

	// ¿Se puede salir ese día? Todas las noches entre la llegada y la salida tienen que estar libres
	function salidaValida(fecha) {
		if (!entrada || fecha <= entrada) return false;
		if (noches(entrada, fecha) < datos.minimoNoches) return false;
		for (let f = new Date(entrada); f < fecha; f.setDate(f.getDate() + 1)) {
			if (estaOcupado(f)) return false;
		}
		return true;
	}

	function elegir(fecha) {
		const libre = fecha >= hoy && !estaOcupado(fecha);
		if (entrada && !salida && salidaValida(fecha)) {
			salida = fecha;
		} else if (libre) {
			entrada = fecha; // primer toque, o empezar de nuevo
			salida = null;
		}
		dibujar();
	}

	function dibujarMes(anio, mes) {
		const primero = new Date(anio, mes, 1);
		const diasEnMes = new Date(anio, mes + 1, 0).getDate();
		const huecos = (primero.getDay() + 6) % 7; // semana empieza en lunes
		const eligiendoSalida = entrada && !salida;

		let html = `<div class="mes"><h3>${MESES[mes]} ${anio}</h3><div class="grilla-dias">`;
		html += DIAS.map((d) => `<span class="cabecera">${d}</span>`).join('');
		html += '<span></span>'.repeat(huecos);
		for (let dia = 1; dia <= diasEnMes; dia++) {
			const fecha = new Date(anio, mes, dia);
			const t = fecha.getTime();
			const pasado = fecha < hoy;
			const ocupado = !pasado && estaOcupado(fecha);
			let clase = 'dia';
			if (pasado) clase += ' pasado';
			else if (ocupado) clase += ' ocupado';
			else clase += ' libre';
			if (t === hoy.getTime()) clase += ' hoy';
			if (entrada && t === entrada.getTime()) clase += ' elegido';
			if (salida && t === salida.getTime()) clase += ' elegido';
			if (entrada && salida && fecha > entrada && fecha < salida) clase += ' en-rango';
			if (eligiendoSalida && fecha > entrada && !salidaValida(fecha)) clase += ' no-disponible';

			// Se puede tocar un día libre, o un día ocupado si sirve como salida
			const sePuedeTocar = !pasado && (!ocupado || (eligiendoSalida && salidaValida(fecha)));
			const precio = !pasado && !ocupado ? `<small>${pesos(datos.precio)}</small>` : '';
			html += sePuedeTocar
				? `<button type="button" class="${clase}" data-fecha="${aTexto(fecha)}">${dia}${precio}</button>`
				: `<span class="${clase}">${dia}${precio}</span>`;
		}
		return html + '</div></div>';
	}

	function actualizarBuscador() {
		const txtEntrada = document.getElementById('txt-entrada');
		const txtSalida = document.getElementById('txt-salida');
		const resumen = document.getElementById('resumen');
		const boton = document.getElementById('consultar');
		const cantidad = document.getElementById('huespedes').value;

		txtEntrada.textContent = entrada ? corta(entrada) : 'Elegí una fecha';
		txtEntrada.classList.toggle('vacio', !entrada);
		txtSalida.textContent = salida ? corta(salida) : 'Elegí una fecha';
		txtSalida.classList.toggle('vacio', !salida);
		document.getElementById('limpiar').hidden = !entrada;

		if (!entrada || !salida) {
			resumen.textContent = entrada
				? 'Ahora tocá el día de salida.'
				: 'Tocá en el calendario el día de llegada y después el de salida.';
			boton.classList.add('desactivado');
			boton.setAttribute('aria-disabled', 'true');
			boton.removeAttribute('href');
			return;
		}

		const n = noches(entrada, salida);
		const total = n * datos.precio;
		resumen.innerHTML = `${n} ${n === 1 ? 'noche' : 'noches'} × ${pesos(datos.precio)} = <strong>${pesos(total)}</strong>`;

		const mensaje =
			`Hola! Quería consultar por ${datos.nombre} del ${larga(entrada)} al ${larga(salida)} ` +
			`(${n} ${n === 1 ? 'noche' : 'noches'}, ${cantidad} ${cantidad === '1' ? 'huésped' : 'huéspedes'}). ` +
			`Total estimado: ${pesos(total)}. ¿Está disponible?`;
		if (datos.whatsapp) {
			boton.href = `https://wa.me/${datos.whatsapp}?text=${encodeURIComponent(mensaje)}`;
		} else if (datos.email) {
			boton.textContent = 'Consultar por email';
			boton.href = `mailto:${datos.email}?subject=${encodeURIComponent('Consulta ' + datos.nombre)}&body=${encodeURIComponent(mensaje)}`;
		}
		boton.classList.remove('desactivado');
		boton.removeAttribute('aria-disabled');
	}

	function dibujar() {
		const contenedor = document.getElementById('calendario');
		let html = '';
		for (let i = 0; i < 3; i++) {
			const fecha = new Date(hoy.getFullYear(), hoy.getMonth() + desplazamiento + i, 1);
			html += dibujarMes(fecha.getFullYear(), fecha.getMonth());
		}
		contenedor.innerHTML = html;
		document.getElementById('anterior').disabled = desplazamiento <= 0;
		actualizarBuscador();
	}

	document.getElementById('calendario').onclick = (e) => {
		const dia = e.target.closest('button[data-fecha]');
		if (dia) elegir(aFecha(dia.dataset.fecha));
	};
	document.getElementById('anterior').onclick = () => { desplazamiento -= 3; dibujar(); };
	document.getElementById('siguiente').onclick = () => { desplazamiento += 3; dibujar(); };
	document.getElementById('limpiar').onclick = () => { entrada = null; salida = null; dibujar(); };
	document.getElementById('huespedes').onchange = actualizarBuscador;
	dibujar();
</script>

<style>
	.buscador {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		background: white;
		border: 1px solid var(--borde);
		border-radius: 999px;
		padding: 0.5rem 0.5rem 0.5rem 1.2rem;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
	}
	.campo { display: flex; flex-direction: column; flex: 1 1 8rem; padding: 0.2rem 0.6rem; border-right: 1px solid var(--borde); }
	.campo.ultimo { border-right: none; }
	.etiqueta { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
	.valor { font-size: 0.95rem; }
	.valor.vacio { color: var(--suave); }
	select.valor { border: none; background: none; padding: 0; font: inherit; color: inherit; cursor: pointer; }
	.buscador .boton { margin-left: auto; }
	.boton.desactivado { opacity: 0.45; pointer-events: none; }
	.resumen { margin: 0.8rem 0 0; font-size: 1.05rem; min-height: 1.6em; }

	@media (max-width: 640px) {
		.buscador { border-radius: var(--radio); padding: 0.8rem; }
		.campo { border-right: none; }
		.buscador .boton { width: 100%; text-align: center; }
	}

	.ayuda { color: var(--suave); margin-top: 1.5rem; }
	.muestra { display: inline-block; width: 0.9em; height: 0.9em; border-radius: 3px; vertical-align: middle; margin-left: 0.4em; }
	.muestra.libre { background: white; border: 1px solid var(--borde); }
	.muestra.ocupado { background: var(--ocupado); }
	.controles { display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
	.flecha {
		width: 2.4rem; height: 2.4rem; border-radius: 50%;
		border: 1px solid var(--borde); background: white; font-size: 1.3rem; cursor: pointer;
	}
	.flecha:disabled { opacity: 0.4; cursor: default; }
	.limpiar { margin-right: auto; border: none; background: none; color: var(--acento); text-decoration: underline; cursor: pointer; font: inherit; }
	.meses {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
		gap: 1.5rem;
	}
	/* :global hace falta porque estos elementos los crea el JavaScript */
	.meses :global(.mes) { background: white; border: 1px solid var(--borde); border-radius: var(--radio); padding: 1rem 0.7rem; }
	.meses :global(h3) { margin: 0 0 0.6rem; text-align: center; }
	.meses :global(.grilla-dias) { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; text-align: center; }
	.meses :global(.cabecera) { font-size: 0.8rem; color: var(--suave); font-weight: 600; }
	.meses :global(.dia) {
		display: flex; flex-direction: column; align-items: center;
		padding: 0.3rem 0; border: none; border-radius: 6px; background: none;
		font: inherit; font-size: 0.9rem; line-height: 1.3; color: inherit;
	}
	.meses :global(.dia small) { font-size: 0.58rem; color: var(--suave); letter-spacing: -0.02em; white-space: nowrap; }
	.meses :global(button.dia) { cursor: pointer; }
	.meses :global(button.dia:hover) { background: var(--acento-claro); }
	.meses :global(.pasado) { color: #c4beb4; }
	.meses :global(.ocupado) { background: var(--ocupado); color: white; }
	.meses :global(.no-disponible) { opacity: 0.35; }
	.meses :global(.hoy) { outline: 2px solid var(--acento); }
	.meses :global(.en-rango) { background: var(--acento-claro); }
	.meses :global(.elegido),
	.meses :global(button.elegido:hover) { background: var(--acento); color: white; }
	.meses :global(.elegido small) { color: white; }
</style>
